# Startup normally loads config/profiles/current-e6.json automatically.
# Override network/persistence with scripts/start-local.mjs flags.
BLUSTONE_BIND_HOST=127.0.0.1
BLUSTONE_PORT=8080
BLUSTONE_BASE_URL=http://127.0.0.1:8080
# Account/transport secrets remain ignored.
BLUSTONE_STATE_FILE=./var/state.json
# npm does not automatically load this example; it documents optional overrides.

# Optional historical trace requirement projection; default remains local-fixture.
# BLUSTONE_TRACE_THRESHOLD_PROFILE=archive-images-2017-2018
# This changes requirements to Sylvester20/Gerard40; guided reward stays LOCAL10.

# Optional historical high-quality bait offer; explicit daily cap is LOCAL policy.
# BLUSTONE_BAIT_SHOP_MODE=archive-2018-projection
# BLUSTONE_BAIT_SHOP_DAILY_LIMIT=2
# Buys10 LU003 for6 Manda; no catch or fishing settlement is enabled.

# Optional reconstructed My Info WebView with historical rename/status policy.
# BLUSTONE_PROFILE_MODE=archive-profile-projection
# First profile rename free, later100Manda; status max50. Captured edits use schema7.

# Optional GC6 gifts; recipient points are explicit LOCAL policy, original amount unknown.
# BLUSTONE_VETERAN_GIFT_MODE=local-points
# BLUSTONE_VETERAN_POINTS_PER_TICKET=25
# No tickets are issued by enabling this mode.

# Optional historical Rupee quote with LOCAL IDs, shared cap and base-only payout.
# BLUSTONE_RUPEE_SHOP_MODE=archive-2021-base-only
# Or archive-2017-base-only (10Manda instead of the observed2021 price5).
# BLUSTONE_RUPEE_SHOP_DAILY_LIMIT=3
# Coupon4 costs one owned local_rupee_coupon; no coupon grants or jackpots.

# Optional2018 base quotes: AP60/BP2 for5Manda/5000Rupees/one owned coupon.
# BLUSTONE_RESOURCE_SHOP_MODE=archive-2018-base-only
# BLUSTONE_RESOURCE_AP_DAILY_LIMIT=3
# BLUSTONE_RESOURCE_BP_DAILY_LIMIT=3
# Both caps are required LOCAL policy; existing paid counts persist across modes.
